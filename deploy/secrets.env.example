# Secrets for the public deployment.
#
# Copy to /etc/dsh-camera/env (NOT to deploy/secrets.env -- setup-server.sh
# reads /etc/dsh-camera/env and refuses to run without it), fill in, and keep it
# out of git.  Keeping it outside the repository means a misconfigured static
# file server cannot publish it.
#
#     sudo install -d -m 700 /etc/dsh-camera
#     sudo install -m 600 deploy/secrets.env.example /etc/dsh-camera/env
#     sudo $EDITOR /etc/dsh-camera/env
#
# setup-server.sh loads it with `set -a; . /etc/dsh-camera/env`, so every
# variable below reaches the script, and systemd hands the same file to the
# services via EnvironmentFile=.
#
# Generate the random values with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared secret that clients must present to use the signalling server.
# The page link carries it:  http://<host>:8765/index_latency.html?token=...
# If it is empty the signalling server runs with NO authentication, which is
# only acceptable on a trusted LAN.
DSH_ACCESS_TOKEN=

# coturn's static-auth-secret, used to mint time-limited TURN credentials.
# Never appears in anything a browser can read.
DSH_TURN_SECRET=

# How long a minted TURN credential stays valid, in seconds.
DSH_TURN_TTL_SECONDS=3600

# TURN realm -- any stable label will do.
DSH_TURN_REALM=dsh-camera

# Public TURN/STUN URLs handed to clients.  Setup fills these in with the
# server's public IP; listed here for reference.
# DSH_TURN_URL=turn:<public-ip>:3478?transport=udp
# DSH_STUN_URL=stun:<public-ip>:3478

# Outbound budget for deploy/traffic_guard.py, in GB per day.  Past it the guard
# stops coturn by itself.  setup-server.sh writes 5 if this is unset.
# DSH_DAILY_TX_BUDGET_GB=5
